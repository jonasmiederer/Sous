{
  "app": "node dist/infra/bin/sous.js",
  "output": "cdk.out",
  "watch": {
    "include": ["src/**", "infra/**"],
    "exclude": ["**/*.test.ts", "dist", "cdk.out", "node_modules"]
  },
  "context": {
    "agentRuntimeMode": "asset",
    "agentModelId": "global.amazon.nova-2-lite-v1:0",
    "crossAccountModelRoleArn": "arn:aws:iam::677276073601:role/sous-bedrock-invoke-role",
    "crossAccountModelId": "global.anthropic.claude-sonnet-5-5",
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/aws-iam:minimizePolicies": true
  }
}
